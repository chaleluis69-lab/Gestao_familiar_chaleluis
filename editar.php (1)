<?php 
include 'conexao.php';

if (!isset($_GET['id']) || empty($_GET['id'])) {
    header("Location: listar.php");
    exit;
}

$id = (int)$_GET['id'];

$query = $conn->query("SELECT * FROM pessoas WHERE id = $id");
$pessoa = $query->fetch_assoc();

if (!$pessoa) {
    die("Erro: Registo não encontrado.");
}
$sql_lista = "SELECT id, nome, apelido_familiar FROM pessoas WHERE id != $id ORDER BY nome ASC";
$res_lista = $conn->query($sql_lista);
$pessoas_disponiveis = [];

while($row = $res_lista->fetch_assoc()) {
    $pessoas_disponiveis[] = $row;
}
?>
